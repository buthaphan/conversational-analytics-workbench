{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(aws *)",
      "Bash(terraform *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git branch *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git -C *)",
      "PowerShell(git -c *)",
      "PowerShell(aws *)",
      "PowerShell(terraform *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.aws/**)",
      "Read(./**/.aws/**)",
      "Read(./.ssh/**)",
      "Read(./**/.ssh/**)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(npx *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(pnpm add *)",
      "PowerShell(yarn add *)",
      "PowerShell(npx *)"
    ]
  }
}
