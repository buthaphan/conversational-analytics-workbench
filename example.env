# Local development settings. Copy this file to .env (which Git ignores) and adjust if needed.
# Every value here is a local placeholder, not a secret. Never put real credentials in this file.

# --- PostgreSQL (docker compose) ---
# Database user, password, and name created by the postgres container on first start.
POSTGRES_USER=cawb
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=cawb
# Host port for PostgreSQL, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- API ---
# Connection string the API and Prisma use (npm-based development connects through the published port).
DATABASE_URL=postgresql://cawb:local-dev-only-change-me@localhost:5432/cawb
# Separate database for automated API tests; the container creates "<POSTGRES_DB>_test" on first start.
# Tests refuse to run unless the database name ends in "_test".
TEST_DATABASE_URL=postgresql://cawb:local-dev-only-change-me@localhost:5432/cawb_test
# development, test, or production.
NODE_ENV=development
# Port the API listens on during npm-based development.
API_PORT=3000
# Optional: network interface the API listens on. Default 127.0.0.1 (this computer only); the API
# container sets 0.0.0.0 itself.
# API_HOST=127.0.0.1
# The only origin allowed to send POST requests (the web app's address).
# npm-based development: http://localhost:5173. docker compose: http://127.0.0.1:8080.
APP_ORIGIN=http://localhost:5173
# true sends the session cookie only over HTTPS. Must be true in production; false for local HTTP.
COOKIE_SECURE=false
# Optional: shorter inactivity timeout in seconds for manual testing (maximum and default 600).
# SESSION_IDLE_TIMEOUT_SECONDS=120
# Must be true for the development seed (user@example.test) to run. Never set in production.
ALLOW_DEV_SEED=true

# --- Web (docker compose) ---
# Host port for the web app, bound to 127.0.0.1 only.
WEB_PORT=8080
